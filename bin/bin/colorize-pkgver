#!/usr/bin/env python3

"""Colorize pacman/aurutils version comparisons from stdin.

Reads lines like `pkg old -> new`,
detects the first differing version segment,
and highlights that segment red in the old version
and green in the new version,
printing all entries as an aligned single-line table.

Example:

    updated-package     0.3.6-1 -> 0.5.0-1
    foo                 1.2-1   -> 1.3-1

with `3`/`2` in red and `5`/`3` in green.

Date-based versions (datever/calver) are highlighted yellow on both sides instead,
because which date component moved carries no information.
"""

import fnmatch
import re
import sys
from datetime import date

RESET = "\033[0m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"

TOKEN_RE = re.compile(r"(\d+|[A-Za-z]+|[^A-Za-z\d]+)")
EPOCH_RE = re.compile(r"^(\d+:)")

# Packages whose versions are dates in a shape that cannot be told apart
# from an ordinary version number, such as yazi's `YY.M.D`.
# `fnmatch` patterns are allowed.
DATEVER_PACKAGE_PATTERNS = (
    "yazi*",
)

# A trailing time or daily counter, e.g. `20260826.113000` or `2026.08.26.3`.
DATEVER_SUFFIX = r"(?:[.\-_+].*)?"
# Unambiguous shapes: a four digit year followed by two digit month and day.
COMPACT_DATEVER_RE = re.compile(rf"^(\d{{4}})(\d{{2}})(\d{{2}}){DATEVER_SUFFIX}$")
SEPARATED_DATEVER_RE = re.compile(
    rf"^(\d{{4}})([.\-_])(\d{{2}})\2(\d{{2}}){DATEVER_SUFFIX}$"
)
# Ambiguous shape, only trusted for curated packages:
# a two or four digit year with unpadded month and day.
LOOSE_DATEVER_RE = re.compile(
    rf"^(\d{{2,4}})([.\-_])(\d{{1,2}})\2(\d{{1,2}}){DATEVER_SUFFIX}$"
)
EARLIEST_DATEVER_YEAR = 1990


def tokenize(version: str) -> list[str]:
    return TOKEN_RE.findall(version)


def is_datever_package(pkg: str) -> bool:
    # Some frontends prefix the repository, as in `aur/yazi`.
    name = pkg.rpartition("/")[2]
    return any(
        fnmatch.fnmatchcase(name, pattern) for pattern in DATEVER_PACKAGE_PATTERNS
    )


def is_datever(pkgver: str, allow_ambiguous: bool) -> bool:
    match = COMPACT_DATEVER_RE.match(pkgver)
    if match:
        year, month, day = match.group(1, 2, 3)
        return is_plausible_date(year, month, day)

    match = SEPARATED_DATEVER_RE.match(pkgver)
    if match:
        year, month, day = match.group(1, 3, 4)
        return is_plausible_date(year, month, day)

    if not allow_ambiguous:
        return False

    match = LOOSE_DATEVER_RE.match(pkgver)
    if match:
        year, month, day = match.group(1, 3, 4)
        return is_plausible_date(year, month, day, allow_two_digit_year=True)

    return False


def is_plausible_date(
    year: str, month: str, day: str, allow_two_digit_year: bool = False
) -> bool:
    if not 1 <= int(month) <= 12:
        return False
    if not 1 <= int(day) <= 31:
        return False
    if len(year) == 4:
        return EARLIEST_DATEVER_YEAR <= int(year) <= date.today().year + 1
    return allow_two_digit_year


def is_datever_bump(pkg: str, old_pkgver: str, new_pkgver: str) -> bool:
    allow_ambiguous = is_datever_package(pkg)
    return is_datever(old_pkgver, allow_ambiguous) and is_datever(
        new_pkgver, allow_ambiguous
    )


def split_epoch(version: str) -> tuple[str, str]:
    match = EPOCH_RE.match(version)
    if not match:
        return "", version
    epoch_str = match.group(1)
    return epoch_str, version[len(epoch_str):]


def epoch_value(epoch_str: str) -> int:
    return int(epoch_str[:-1]) if epoch_str else 0


def split_pkgrel(version: str) -> tuple[str, str]:
    """Split `pkgver-pkgrel` into its parts; a pkgver never contains a hyphen."""
    pkgver, _, pkgrel = version.rpartition("-")
    if not pkgver:
        return version, ""
    return pkgver, f"-{pkgrel}"


def colorize_versions(pkg: str, old: str, new: str) -> tuple[str, str]:
    old_epoch, old_rest = split_epoch(old)
    new_epoch, new_rest = split_epoch(new)

    if epoch_value(old_epoch) != epoch_value(new_epoch):
        return (
            f"{RED}{old_epoch}{RESET}{old_rest}",
            f"{GREEN}{new_epoch}{RESET}{new_rest}",
        )

    old_pkgver, old_pkgrel = split_pkgrel(old_rest)
    new_pkgver, new_pkgrel = split_pkgrel(new_rest)

    # A pkgrel moving along with the date carries no information either,
    # so it stays uncolored; a pkgrel-only bump falls through to the token diff.
    if old_pkgver != new_pkgver and is_datever_bump(pkg, old_pkgver, new_pkgver):
        return (
            f"{old_epoch}{YELLOW}{old_pkgver}{RESET}{old_pkgrel}",
            f"{new_epoch}{YELLOW}{new_pkgver}{RESET}{new_pkgrel}",
        )

    old_out, new_out = colorize_version_tokens(old_rest, new_rest)
    return old_epoch + old_out, new_epoch + new_out


def colorize_version_tokens(old: str, new: str) -> tuple[str, str]:
    old_tokens = tokenize(old)
    new_tokens = tokenize(new)

    first_diff = None
    for idx, (old_tok, new_tok) in enumerate(zip(old_tokens, new_tokens)):
        if old_tok != new_tok:
            first_diff = idx
            break
    if first_diff is None:
        if len(old_tokens) != len(new_tokens):
            first_diff = min(len(old_tokens), len(new_tokens))
        else:
            return old, new

    old_out: list[str] = []
    new_out: list[str] = []

    for idx, tok in enumerate(old_tokens):
        if idx < first_diff:
            old_out.append(tok)
        elif idx == first_diff:
            old_out.append(f"{RED}{tok}{RESET}")
        else:
            old_out.append(tok)

    for idx, tok in enumerate(new_tokens):
        if idx < first_diff:
            new_out.append(tok)
        elif idx == first_diff:
            new_out.append(f"{GREEN}{tok}{RESET}")
        else:
            new_out.append(tok)

    return "".join(old_out), "".join(new_out)


LINE_RE = re.compile(r"^(?P<pkg>.+?)\s+(?P<old>.+?)\s+->\s+(?P<new>.+?)\s*$")


def format_entry(pkg: str, old: str, new: str, pkg_width: int, old_width: int) -> str:
    old_colored, new_colored = colorize_versions(pkg, old, new)
    pkg_padding = " " * (pkg_width - len(pkg))
    old_padding = " " * (old_width - len(old))
    return f"{pkg}{pkg_padding} {old_colored}{old_padding} -> {new_colored}"


def main() -> int:
    lines = [line.rstrip("\n") for line in sys.stdin]
    matches: list[tuple[tuple[str, str, str] | None, str]] = []

    for line in lines:
        match = LINE_RE.match(line)
        if not match:
            matches.append((None, line))
            continue

        pkg = match.group("pkg")
        old = match.group("old")
        new = match.group("new")
        matches.append(((pkg, old, new), line))

    parsed_entries = [parsed for parsed, _ in matches if parsed is not None]
    pkg_width = max((len(pkg) for pkg, _, _ in parsed_entries), default=0)
    old_width = max((len(old) for _, old, _ in parsed_entries), default=0)

    for parsed, original in matches:
        if parsed is None:
            print(original)
            continue

        pkg, old, new = parsed
        print(format_entry(pkg, old, new, pkg_width, old_width))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
