{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/inject-agents-md.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .message | xargs -I{} sh -c \"notify-send --urgency=critical 'Claude Code' '{}' && paplay ~/.claude/sounds/notify.flac\""
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Session finished' && paplay ~/.claude/sounds/notify.flac"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /tmp/claude-hooks.log"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Working"]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "prefersReducedMotion": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "sonnet"
}
