# https://wiki.archlinux.org/index.php/Xprofile

# set steam to minimize to tray
export STEAM_FRAME_FORCE_CLOSE=1

# config fcitx5
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx
# forward to D-Bus-activated apps and systemd user units
dbus-update-activation-environment --systemd GTK_IM_MODULE QT_IM_MODULE XMODIFIERS SDL_IM_MODULE

# disable "bell" beeper
xset b off
# disable screen saver and power management
xset -dpms s off

# set wallpaper
[ -x ~/.fehbg ] && ~/.fehbg
