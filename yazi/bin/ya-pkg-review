#!/bin/bash
# ya-pkg-review - review pending yazi package upgrades before applying them
#
# Usage: ya-pkg-review
#
# Fetches the package clones that `ya pkg` keeps in its cache,
# and for each package with new commits offers to list them,
# to review them one by one or as a single diff through the git pager,
# and to accept or skip the upgrade.
# It then runs `ya pkg upgrade` for the accepted ones after a final confirmation.
# Packages whose `rev` starts with `=` are pinned and skipped, like `ya` does.
set -o errexit
shopt -s nullglob

XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
package_toml=${YAZI_CONFIG_HOME:-$HOME/.config/yazi}/package.toml
clones_dir=$XDG_CACHE_HOME/yazi/packages

# Prints one `<use> <rev>` line per plugin and flavor dependency.
read_deps() {
    python -I -c '
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    toml = tomllib.load(f)
for section in ("plugin", "flavor"):
    for dep in toml.get(section, {}).get("deps", []):
        print(dep["use"], dep["rev"])
' "$package_toml"
}

# Mirrors `Dependency::remote()` in yazi-cli:
# a `use` without `:` refers to the repository `<use>.yazi`.
remote_of() {
    local use=$1
    if [[ $use == *:* ]]; then
        printf 'https://github.com/%s.git\n' "${use%%:*}"
    else
        printf 'https://github.com/%s.yazi.git\n' "$use"
    fi
}

path_of() {
    local use=$1
    if [[ $use == *:* ]]; then
        printf '%s.yazi\n' "${use#*:}"
    else
        printf '.\n'
    fi
}

# Reads a single key from the terminal, since stdout may be a pager's.
prompt_key() {
    local key
    printf '%s ' "$1" >/dev/tty
    read -rn1 key </dev/tty
    printf '\n' >/dev/tty
    printf '%s\n' "$key"
}

if [[ ! -f $package_toml ]]; then
    printf >&2 '%s: %s not found\n' "${0##*/}" "$package_toml"
    exit 1
fi

# The clone directories are named after a hash of the remote URL,
# so look them up by their origin instead of recomputing it.
declare -A clone_of
for dir in "$clones_dir"/*/; do
    url=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
    clone_of[$url]=${dir%/}
done

declare -A fetched
pending=() pending_revs=() pending_clones=() pending_paths=() pending_targets=()

# The dependencies come in on fd 3, so that git cannot consume them from stdin.
while read -r -u 3 use rev; do
    [[ $rev == =* ]] && continue

    clone=${clone_of[$(remote_of "$use")]}
    if [[ -z $clone ]]; then
        printf >&2 "%s: no clone for %s, run 'ya pkg install' first\n" "${0##*/}" "$use"
        continue
    fi
    if [[ -z ${fetched[$clone]} ]]; then
        printf 'Fetching %s\n' "$use"
        git -C "$clone" fetch --quiet
        fetched[$clone]=1
    fi

    path=$(path_of "$use")
    target=$(git -C "$clone" rev-parse origin/HEAD)
    [[ -n $(git -C "$clone" rev-list "$rev..$target" -- "$path") ]] || continue

    pending+=("$use")
    pending_revs+=("$rev")
    pending_clones+=("$clone")
    pending_paths+=("$path")
    pending_targets+=("$target")
done 3< <(read_deps)

if (( ! ${#pending[@]} )); then
    printf 'Nothing to upgrade\n'
    exit 0
fi

# Shows the commit messages followed by the combined diff of all commits.
# Git cannot produce both in one command,
# so the output is piped to the git pager, run through the shell like git does.
show_full_diff() {
    local clone=$1 range=$2 path=$3
    {
        git -C "$clone" log --color=always --reverse "$range" -- "$path"
        printf '\n'
        git -C "$clone" diff --color=always --stat --patch "$range" -- "$path"
    } | sh -c "$(git var GIT_PAGER)"
}

reviewed=() decisions=() accepted=() accepted_commits=()

for i in "${!pending[@]}"; do
    use=${pending[i]}
    rev=${pending_revs[i]}
    clone=${pending_clones[i]}
    path=${pending_paths[i]}
    target=${pending_targets[i]}
    range=$rev..$(git -C "$clone" rev-parse --short "$target")
    count=$(git -C "$clone" rev-list --count "$range" -- "$path")

    printf '\n%s: %d new commits (%s)\n' "$use" "$count" "$range"
    decision=
    while [[ -z $decision ]]; do
        case $(prompt_key "[l]ist commits/review [c]ommits/review [d]iff/[u]pgrade/[s]kip/[q]uit?") in
            l) git -C "$clone" log --reverse --format='%C(yellow)%h%C(reset) %s' "$range" -- "$path" ;;
            c) git -C "$clone" log --reverse --patch --stat "$range" -- "$path" ;;
            d) show_full_diff "$clone" "$range" "$path" ;;
            u) decision=upgrade ;;
            s) decision=skip ;;
            q) break 2 ;;
        esac
    done

    reviewed+=("$use")
    if [[ $decision == upgrade ]]; then
        decisions+=("upgrade  $range")
        accepted+=("$use")
        accepted_commits+=("$target")
    else
        decisions+=("keep     $rev")
    fi
done

if (( ! ${#reviewed[@]} )); then
    exit 0
fi

printf '\nSummary:\n'
for i in "${!reviewed[@]}"; do
    printf '  %-45s %s\n' "${reviewed[i]}" "${decisions[i]}"
done

if (( ! ${#accepted[@]} )); then
    exit 0
fi
[[ $(prompt_key "Upgrade ${#accepted[@]} packages? [y/N]") == y ]] || exit 0

ya pkg upgrade "${accepted[@]}"

# `ya pkg upgrade` pulls again,
# so it may have picked up commits that landed after the review.
declare -A new_rev_of
while read -r use rev; do
    new_rev_of[$use]=$rev
done < <(read_deps)
for i in "${!accepted[@]}"; do
    use=${accepted[i]}
    clone=${clone_of[$(remote_of "$use")]}
    new_commit=$(git -C "$clone" rev-parse "${new_rev_of[$use]}^{commit}")
    if [[ $new_commit != "${accepted_commits[i]}" ]]; then
        printf >&2 'warning: %s was upgraded to %s, not to the reviewed commit\n' \
            "$use" "${new_rev_of[$use]}"
    fi
done

printf 'Remember to commit %s\n' "$package_toml"
